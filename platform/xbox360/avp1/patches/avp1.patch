+#if defined(AVP_XBOX360)
+extern int AvP360_MenusActive(void);
+
+/* Controle do Xbox 360: analogico direito vira o mouselook; nos menus, direcional/analogico esquerdo viram as setas,
+ * A vira Enter e B vira Esc; Start e sempre Esc (abre e fecha o menu de pausa). */
+static void Xbox360PadKey(int key, int down, int *was)
+{
+	if (down != *was)
+		handle_keypress(key, key == KEY_CR ? 13 : 0, down);
+	*was = down;
+}
+
+static float Xbox360Stick(Sint16 v)
+{
+	const float dead = 7849.0f;
+	float f = (float)v;
+	float s = f < 0 ? -1.0f : 1.0f;
+	f = f < 0 ? -f : f;
+	if (f < dead)
+		return 0.0f;
+	f = (f - dead) / (32767.0f - dead);
+	if (f > 1.0f)
+		f = 1.0f;
+	return s * f * f;
+}
+
+static void Xbox360PadFrame(void)
+{
+	static int up, down, left, right, enter, esc, start;
+	if (!gamepad)
+		return;
+	const int menus = AvP360_MenusActive();
+	const Sint16 ly = SDL_GetGamepadAxis(gamepad, SDL_GAMEPAD_AXIS_LEFTY);
+	const Sint16 lx = SDL_GetGamepadAxis(gamepad, SDL_GAMEPAD_AXIS_LEFTX);
+	Xbox360PadKey(KEY_UP, menus && (SDL_GetGamepadButton(gamepad, SDL_GAMEPAD_BUTTON_DPAD_UP) || ly < -20000), &up);
+	Xbox360PadKey(KEY_DOWN, menus && (SDL_GetGamepadButton(gamepad, SDL_GAMEPAD_BUTTON_DPAD_DOWN) || ly > 20000), &down);
+	Xbox360PadKey(KEY_LEFT, menus && (SDL_GetGamepadButton(gamepad, SDL_GAMEPAD_BUTTON_DPAD_LEFT) || lx < -20000), &left);
+	Xbox360PadKey(KEY_RIGHT, menus && (SDL_GetGamepadButton(gamepad, SDL_GAMEPAD_BUTTON_DPAD_RIGHT) || lx > 20000), &right);
+	Xbox360PadKey(KEY_CR, menus && SDL_GetGamepadButton(gamepad, SDL_GAMEPAD_BUTTON_SOUTH), &enter);
+	Xbox360PadKey(KEY_ESCAPE, menus && SDL_GetGamepadButton(gamepad, SDL_GAMEPAD_BUTTON_EAST), &esc);
+	Xbox360PadKey(KEY_ESCAPE, SDL_GetGamepadButton(gamepad, SDL_GAMEPAD_BUTTON_START), &start);
+
+	if (menus)
+		return;
+	/* Mira: pixels de mouse por segundo com o analogico no fim do curso. */
+	const float speed_x = 1400.0f, speed_y = 900.0f;
+	const float dt = (float)NormalFrameTime / 65536.0f;
+	const float dx = Xbox360Stick(SDL_GetGamepadAxis(gamepad, SDL_GAMEPAD_AXIS_RIGHTX)) * speed_x * dt;
+	const float dy = Xbox360Stick(SDL_GetGamepadAxis(gamepad, SDL_GAMEPAD_AXIS_RIGHTY)) * speed_y * dt;
+	MouseDeltaX = dx;
+	MouseDeltaY = dy;
+	MouseVelX = DIV_FIXED((int)dx, NormalFrameTime);
+	MouseVelY = DIV_FIXED((int)dy, NormalFrameTime);
+}
+#endif
